pipeline {
    agent any

    stages {
        stage('Clone Repo') {
            steps {
                git 'https://github.com/ganeshmalepati/PractiseFiles.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build('proj-runner', './Proj')
                }
            }
        }

        stage('Run Python Files') {
            steps {
                script {
                    docker.image('proj-runner').inside {
                        sh 'echo "All Python files executed."'
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed.'
        }
    }
}

